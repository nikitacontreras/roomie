{
  "name": "roomie",
  "version": "1.2.0",
  "description": "ROM metadata helper for classic consoles (NES, SNES, N64, GB/GBA, NDS, Genesis, SMS, WonderSwan, PCE)",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && tsc && tsc -p tsconfig.cjs.json && node scripts/emit-dual.js",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "rom",
    "metadata",
    "nes",
    "snes",
    "n64",
    "gameboy",
    "gba",
    "nds",
    "genesis",
    "emulation",
    "crc32",
    "no-intro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikitacontreras/roomie.git"
  },
  "bugs": {
    "url": "https://github.com/nikitacontreras/roomie/issues"
  },
  "homepage": "https://github.com/nikitacontreras/roomie#readme",
  "devDependencies": {
    "@types/node": "^20.19.37",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
